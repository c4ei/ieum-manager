[Unit]
Description=IEUM limited node recovery agent
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/ieum-manager-recovery.env
ExecStart=/opt/ieum-manager/deploy/ieum-recovery-agent.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# chain-event 요청은 네 노드 config/events.json만 고칩니다.
ReadWritePaths=/var/lib/ieum-manager-control /var/log/ieum-recovery /opt/ieum-node1/config /opt/ieum-node2/config /opt/ieum-node3/config /opt/ieum-node4/config
