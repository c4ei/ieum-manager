[Unit]
Description=IEUM Chain Manager
After=network-online.target ieum-chain.service
Wants=network-online.target

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/opt/ieum-manager
Environment=NODE_ENV=production
Environment=IEUM_MANAGER_HOST=127.0.0.1
Environment=IEUM_MANAGER_PORT=8787
Environment=IEUM_MANAGER_CONFIG=/opt/ieum-manager/config.json
ExecStart=/usr/bin/node /opt/ieum-manager/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ieum-manager

[Install]
WantedBy=multi-user.target
